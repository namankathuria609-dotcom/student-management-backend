# Server Port (Using 5001 to avoid default macOS AirPlay Receiver port 5000 conflict)
PORT=5001

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details
# Example: mongodb+srv://myUser:myPassword@cluster0.abcde.mongodb.net/studentDB?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studentDB?retryWrites=true&w=majority
